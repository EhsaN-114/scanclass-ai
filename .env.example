# Laptop (local Ollama):
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_API_KEY=
PORT=3000

# Render (Ollama cloud) - set these in Render > Environment, not in a file:
# OLLAMA_HOST=https://ollama.com
# OLLAMA_MODEL=gemma4:31b
# OLLAMA_API_KEY=your-key-here

# Optional: permanent database (Render Postgres / Supabase / Neon). Leave empty on your laptop.
DATABASE_URL=

# Secret key for the Admin page (gives CRs their PINs). Use a long random value on Render.
ADMIN_KEY=
